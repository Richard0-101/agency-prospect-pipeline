# Copy this file to `.env` and fill in your own values. Never commit the real .env.

# Flask session signing key. Any long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-random-hex-string

# Apollo.io API key (Settings -> Integrations -> API in your Apollo account).
APOLLO_API_KEY=your-apollo-api-key

# OpenAI API key + model used to refine scraped client names.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# --- Google / Gmail OAuth ---
# Path to the OAuth client-secrets JSON downloaded from Google Cloud Console.
GOOGLE_CLIENT_SECRETS_FILE=./client_secret.json
# Must exactly match a redirect URI registered on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/gmail/callback
# Comma-separated OAuth scopes.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.compose

# Allows OAuth over http:// for LOCAL development only. Do not set in production.
OAUTHLIB_INSECURE_TRANSPORT=1
